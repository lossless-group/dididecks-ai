---
/**
 * SourcesPager — a 16:9-safe wrapper for a long Sources list.
 *
 * A naive Sources block can overflow a fixed-height slide and break scroll-snap.
 * This constrains the list to the slide's remaining height with paginated ▲/▼
 * controls (one viewport per page) + a page counter; wheel/trackpad scroll works
 * too, with overscroll-behavior:contain so it won't snap to the next slide.
 * Token-driven; no host classes needed for light/dark/vibrant.
 */
import type { IndexedCitation } from "../../lib/citations/types.ts";
import Sources from "./Sources.astro";

interface Props {
  citations: IndexedCitation[];
  title?: string;
}
const { citations, title = "Sources" } = Astro.props;
---

<div class="ddd-sources-pager">
  <div class="ddd-sources-pager__vp" data-sources-viewport tabindex="0">
    <Sources citations={citations} title={title} />
  </div>
  <div class="ddd-sources-pager__ctl" role="group" aria-label="Scroll sources list">
    <button type="button" class="ddd-sources-pager__btn" data-dir="-1" aria-label="Previous page of sources">&#9650;</button>
    <span class="ddd-sources-pager__pg" data-sources-page>1 / 1</span>
    <button type="button" class="ddd-sources-pager__btn" data-dir="1" aria-label="Next page of sources">&#9660;</button>
  </div>
</div>

<style>
  .ddd-sources-pager { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .ddd-sources-pager__vp {
    flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; scroll-behavior: smooth;
    border: 1px solid var(--color-border, rgba(127,127,140,0.22)); border-radius: 0.6rem;
    padding: 0 clamp(0.75rem, 1.5vw, 1.25rem);
    background: color-mix(in srgb, var(--color-surface, #14141c) 24%, transparent);
  }
  .ddd-sources-pager__vp:focus-visible { outline: 2px solid var(--ddd-cite-accent, var(--color-accent-1, var(--color-accent, currentColor))); outline-offset: 2px; }
  .ddd-sources-pager__ctl { display: flex; align-items: center; justify-content: flex-end; gap: 0.6rem; }
  .ddd-sources-pager__btn {
    font-family: var(--font-mono, ui-monospace, monospace); font-size: 0.8rem; line-height: 1;
    color: var(--color-text-muted, #9a9aa8);
    background: color-mix(in srgb, var(--color-surface, #14141c) 40%, transparent);
    border: 1px solid var(--color-border, rgba(127,127,140,0.22)); border-radius: 999px;
    padding: 0.35rem 0.8rem; cursor: pointer; transition: color 150ms ease, border-color 150ms ease;
  }
  .ddd-sources-pager__btn:hover { color: var(--ddd-cite-accent, var(--color-accent-1, var(--color-accent, currentColor))); border-color: var(--ddd-cite-accent, var(--color-accent-1, var(--color-accent, currentColor))); }
  .ddd-sources-pager__btn:disabled { opacity: 0.35; cursor: default; }
  .ddd-sources-pager__pg { font-family: var(--font-mono, ui-monospace, monospace); font-size: 0.72rem; letter-spacing: 0.14em; color: var(--color-text-muted, #9a9aa8); min-width: 4.5ch; text-align: center; }
</style>

<script>
  function wirePager(pager: Element) {
    const vp = pager.querySelector<HTMLElement>("[data-sources-viewport]");
    const counter = pager.querySelector<HTMLElement>("[data-sources-page]");
    const buttons = pager.querySelectorAll<HTMLButtonElement>("[data-dir]");
    if (!vp || !counter) return;
    const pageCount = () => Math.max(1, Math.ceil(vp.scrollHeight / vp.clientHeight));
    const pageIndex = () => Math.min(pageCount(), Math.round(vp.scrollTop / vp.clientHeight) + 1);
    const render = () => {
      counter.textContent = `${pageIndex()} / ${pageCount()}`;
      buttons.forEach((b) => {
        const dir = Number(b.dataset.dir);
        b.disabled = dir < 0 ? vp.scrollTop <= 1 : vp.scrollTop + vp.clientHeight >= vp.scrollHeight - 1;
      });
    };
    buttons.forEach((b) => b.addEventListener("click", () => {
      vp.scrollBy({ top: Number(b.dataset.dir) * vp.clientHeight * 0.92, behavior: "smooth" });
    }));
    vp.addEventListener("scroll", render, { passive: true });
    window.addEventListener("resize", render);
    render();
  }
  document.querySelectorAll(".ddd-sources-pager").forEach(wirePager);
</script>

# Registry routing for the private @lossless-group scope (GitHub Packages).
# @dididecks/shell is published here as @lossless-group/dididecks-shell;
# client-sites alias it back to the `@dididecks/shell` import specifier via
# an `npm:` dependency spec so no source code needs to change.
@lossless-group:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

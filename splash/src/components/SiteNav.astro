---
const base = import.meta.env.BASE_URL;
const here = Astro.url.pathname;
const links = [
  { href: `${base}changelog/`, label: 'Changelog' },
  { href: `${base}context-v/`, label: 'Context' },
  { href: 'https://github.com/lossless-group/dididecks-ai', label: 'GitHub' },
];
---
<nav class="site-nav" aria-label="Site">
  <div class="container site-nav__inner">
    <a class="site-nav__mark" href={base}>DidiDecks</a>
    <ul>
      {links.map((l) => (
        <li><a href={l.href} aria-current={here.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

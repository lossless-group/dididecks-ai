---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_NAME } from '@lib/seo';
import { OG_SIZES } from '@lib/og-render';

interface Props {
  title?: string;
  description?: string;
  /** Share card key (src/lib/share-cards.ts). Defaults to the home card. */
  shareKey?: string;
  /** Alt text for the share image. Defaults to the title. */
  imageAlt?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, shareKey = 'home', imageAlt } = Astro.props;

const fullTitle = title === SITE_TITLE ? title : `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const base = import.meta.env.BASE_URL;
const image = (variant: 'tall' | 'wide') => new URL(`${base}og/${variant}/${shareKey}.jpg`, Astro.site).toString();
const alt = imageAlt ?? `${title}, on a DidiDecks share card.`;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" type="application/xml" href={`${base}sitemap-index.xml`} />
<link rel="alternate" type="text/markdown" href={`${base}llms.txt`} title="llms.txt for this site" />

{/* One og:image: the tall 3:4 card chat apps show. The wide card is for X only. */}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image('tall')} />
<meta property="og:image:secure_url" content={image('tall')} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={String(OG_SIZES.tall.width)} />
<meta property="og:image:height" content={String(OG_SIZES.tall.height)} />
<meta property="og:image:alt" content={alt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image('wide')} />
<meta name="twitter:image:alt" content={alt} />

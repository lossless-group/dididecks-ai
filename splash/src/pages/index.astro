---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { toDate, isoDate } from '@lib/date';
import { SITE_REPO } from '@lib/seo';

const base = import.meta.env.BASE_URL;

const toolkit = (await getCollection('toolkit')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const changelog = await getCollection('changelog');
const contextV = await getCollection('context-v');

const when = (d: Record<string, unknown>) =>
  toDate(d.date_modified ?? d.date_authored_current_draft ?? d.date_created ?? d.date ?? d.date_authored_initial_draft);
const latest = [...changelog]
  .sort((a, b) => (when(b.data)?.getTime() ?? 0) - (when(a.data)?.getTime() ?? 0))
  .slice(0, 4);

/** Toolkit links are either absolute or a path inside this site. */
const link = (href?: string) => (!href ? undefined : /^https?:/.test(href) ? href : `${base}${href}`);
const docLink = (path: string) => `${base}context-v/dididecks-ai/${path}/`;

const bar = [
  { n: '01', title: 'Every claim has a source', body: 'A number without a source the reader can open is a vibe. Diligence eats vibes for breakfast.' },
  { n: '02', title: 'The PDF holds up', body: 'A deck that looks right on screen and falls apart in the PDF handed across the table doesn’t pass.' },
  { n: '03', title: 'Confidential stays confidential', body: 'Portfolio data that might leak never gets sent at all. Gating is chosen per deck, or per section.' },
];

const loop = [
  { step: 'Ingest', body: 'Take the deck the client already has, a PDF, a PPTX or a Google Doc outline, and pull out every word, number and image.' },
  { step: 'Remake', body: 'Agents design fresh variants from the content alone. The facts are locked; only the design and the wording move.' },
  { step: 'Choose', body: 'Rank each slide and each variant in the shell, then assemble the best of them into one deck.' },
  { step: 'Publish', body: 'Put the deck on the client’s own domain, in their brand, public or behind a sign-in.' },
  { step: 'Present', body: 'Play it live from the browser, or export Keynote, PPTX and PDF for the hand-off.' },
  { step: 'Refresh', body: 'New research or yesterday’s call notes go back in, and the deck reflows without a rebuild.' },
];

const principles = [
  { n: '01', title: 'Auth and publish, balanced', body: 'Confidential by default for sensitive material, easy to publish for the rest, with the line between them visible.' },
  { n: '02', title: 'AI that lifts prior art', body: 'Take an ugly deck to polished in six days. The AI, the deadline and the polish are all non-negotiable.' },
  { n: '03', title: 'Never destroy', body: 'Tweak, embellish, try variants and reorder, but keep every version. Options are part of the deliverable.' },
  { n: '04', title: 'Always playable', body: 'At any moment the deck is ready to present. Opportunities don’t wait for a rebuild.' },
  { n: '05', title: 'Fork for the meeting', body: 'Personalize a deck for one meeting on short notice without breaking the version that always plays.' },
  { n: '06', title: 'Exports that pass for Keynote', body: 'The PDF and slides shouldn’t give away that a web tool made them.' },
  { n: '07', title: 'Fold in what’s new', body: 'Fresh market data or a call transcript lands in the deck fast, and the slides reflow around it.' },
];
---
<BaseLayout shareKey="home">
  <section class="hero">
    <div class="container split split--hero">
      <div class="hero__pitch">
        <p class="eyebrow">ch.01 · dididecks-ai</p>
        <h1>Decks that pass <span class="gradient-text">due diligence.</span></h1>
        <p class="lede">
          DidiDecks builds the decks that get checked line by line: the fund deck an LP reads before
          committing, the update a board picks apart, the data room an acquirer combs through. Decks
          are repositories, slides are components, AI does most of the writing, and every number
          traces back to a source.
        </p>
        <ul class="meta-strip" role="list">
          <li><strong>{toolkit.length}</strong>&nbsp;tools</li>
          <li><strong>27</strong>&nbsp;slide types</li>
          <li><strong>{changelog.length}</strong>&nbsp;changelog entries</li>
          <li><strong>{contextV.length}</strong>&nbsp;context-v docs</li>
        </ul>
      </div>

      <aside class="hero__readout" aria-label="Recent changes">
        <header class="hero__readout-head">
          <span class="eyebrow">recently shipped</span>
          <a class="hero__readout-link" href={`${base}changelog/`}>full changelog →</a>
        </header>
        <ul class="hero__readout-list">
          {latest.map((entry) => {
            const d = when(entry.data);
            return (
              <li class="hero__readout-row">
                <a href={`${base}changelog/${entry.id}/`}>
                  <span class="hero__readout-title">{entry.data.title ?? entry.id}</span>
                  {d && <time class="hero__readout-stamp" datetime={isoDate(d)}>{isoDate(d)}</time>}
                </a>
              </li>
            );
          })}
        </ul>
      </aside>
    </div>
  </section>

  <section id="the-bar">
    <div class="container">
      <p class="eyebrow">ch.02 · the bar</p>
      <h2>DidiDecks is short for due diligence.</h2>
      <p class="lede">
        Gamma and Beautiful.ai make a pretty deck. That isn’t the hard part. The hard part is a deck
        that still stands up when the person on the other side of the table starts checking it.
      </p>
      <div class="grid grid--three">
        {bar.map((b) => (
          <article class="bench-card">
            <span class="bench-card__label">{b.n}</span>
            <div class="bench-card__body">
              <h3>{b.title}</h3>
              <p>{b.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="how-it-works">
    <div class="container">
      <p class="eyebrow">ch.03 · how it works</p>
      <h2>Not one deck. The whole loop.</h2>
      <p class="lede">
        The firms we build for send decks over and over, on short deadlines, with a lot riding on each
        one. Single-deck tools stop at the first draft. DidiDecks covers everything after it.
      </p>
      <ol class="loop" role="list">
        {loop.map((l, i) => (
          <li class="loop__step">
            <span class="loop__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{l.step}</h3>
            <p>{l.body}</p>
          </li>
        ))}
      </ol>

      <figure class="diagram-embed">
        <iframe
          src={`${base}diagrams/remake-deck-loop.html`}
          title="Workflow diagram of the /remake-deck loop: operator, orchestrator, subagents and the gates between them"
          loading="lazy"
        ></iframe>
        <figcaption>
          <strong>Inside /remake-deck.</strong> An orchestrator briefs one agent per job and checks each
          result before the next starts: the extraction is audited before anything is designed, an
          invented fact fails a variant, and two near-identical designs go back with a sharper brief.
          Pan and zoom inside the diagram, or <a href={`${base}diagrams/remake-deck-loop.html`}>open it full screen</a>.
        </figcaption>
      </figure>
    </div>
  </section>

  <section id="toolkit">
    <div class="container">
      <p class="eyebrow">ch.04 · toolkit</p>
      <h2>What’s built.</h2>
      <p class="lede">
        Each piece came out of real client decks and was lifted into shared code once a second deck
        needed it.
      </p>
      <div class="grid grid--toolkit">
        {toolkit.map((t) => {
          const href = link(t.data.href);
          const Card = href ? 'a' : 'article';
          return (
          <Card class:list={['bench-card', href && 'bench-card--link']} href={href}>
            <span class="bench-card__label">{t.data.label}</span>
            <span class="bench-card__status"><span class="pill pill--accent">{t.data.status}</span></span>
            <div class="bench-card__body">
              <h3>{t.data.title}</h3>
              <p>{t.data.lede}</p>
              {t.data.tags && t.data.tags.length > 0 && (
                <ul class="tags" aria-label="Tags">
                  {t.data.tags.map((tag) => <li class="chip">{tag}</li>)}
                </ul>
              )}
            </div>
          </Card>
          );
        })}
      </div>
    </div>
  </section>

  <section id="principles">
    <div class="container">
      <p class="eyebrow">ch.05 · principles</p>
      <h2>Two bets, seven rules.</h2>
      <div class="grid grid--two">
        <article class="bench-card bench-card--bet">
          <span class="bench-card__label">bet · 01</span>
          <div class="bench-card__body">
            <h3>Private to make, white-label to publish</h3>
            <p>
              Partners develop decks with Claude in a private workspace. The finished deck goes out on
              the firm’s own domain and in its own brand, public or gated. The line between the two
              sides is the product.
            </p>
          </div>
        </article>
        <article class="bench-card bench-card--bet">
          <span class="bench-card__label">bet · 02</span>
          <div class="bench-card__body">
            <h3>A player good enough to present from</h3>
            <p>
              The person who made the deck should want to present it live from DidiDecks, in front of
              the LP or the board. Keynote and PDF become what you leave behind, not what you present.
            </p>
          </div>
        </article>
      </div>
      <ol class="rules" role="list">
        {principles.map((p) => (
          <li class="rules__item">
            <span class="rules__n">{p.n}</span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="read-more">
    <div class="container">
      <p class="eyebrow">ch.06 · under the hood</p>
      <h2>How the pieces work.</h2>
      <p class="lede">
        Every shared component, route and runtime in the shell has a page saying what it does and
        who uses it. A few to start with:
      </p>
      <ul class="reading">
        <li><a href={docLink('blueprints/Shared-Content-Modules-Across-Deck-Surfaces')}><span class="reading__kind">blueprint</span>One content module, every deck surface</a></li>
        <li><a href={docLink('sitemap/components/SlideCanvas')}><span class="reading__kind">component</span>SlideCanvas, the 16:9 stage</a></li>
        <li><a href={docLink('sitemap/routes/toc-deck')}><span class="reading__kind">route</span>The deck review matrix</a></li>
        <li><a href={docLink('sitemap/routes/play-print')}><span class="reading__kind">route</span>One-shot PDF export</a></li>
        <li><a href={`${base}context-v/`}><span class="reading__kind">all</span>Every context-v doc →</a></li>
        <li><a href={SITE_REPO}><span class="reading__kind">repo</span>lossless-group/dididecks-ai →</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: var(--space-20) 0 var(--space-16); }
  .hero__pitch h1 { margin-top: var(--space-3); margin-bottom: var(--space-4); }
  .hero__pitch .lede { margin-bottom: var(--space-8); }
  .meta-strip { list-style: none; }
  .meta-strip li { margin: 0; }

  .hero__readout {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    align-self: start;
  }
  .hero__readout-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }
  .hero__readout-link {
    font-family: var(--font__mono);
    font-size: 0.74rem;
    color: var(--color-text-dim);
    border-bottom: none;
  }
  .hero__readout-link:hover { color: var(--color-accent); }
  .hero__readout-list { list-style: none; display: flex; flex-direction: column; }
  .hero__readout-row a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-soft);
  }
  .hero__readout-row:last-child a { border-bottom: 0; }
  .hero__readout-row a:hover { background: var(--color-bg-elevated); color: var(--color-text); }
  .hero__readout-title { font-size: 0.92rem; line-height: 1.4; }
  .hero__readout-stamp {
    font-family: var(--font__mono);
    font-size: 0.7rem;
    color: var(--color-text-faint);
    white-space: nowrap;
  }

  section > .container > .lede { max-width: 62ch; margin-bottom: var(--space-8); }

  .grid--three   { grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .grid--two     { grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); }
  .grid--toolkit { grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); }

  .bench-card--link {
    display: block;
    color: inherit;
    transition: border-color 120ms ease, transform 120ms ease, background 120ms ease;
  }
  .bench-card--link:hover {
    border-color: var(--color-border-accent);
    transform: translateY(-2px);
    background: var(--color-bg-elevated);
    color: inherit;
  }
  /* Cormorant runs small; card titles need more size than the sans did. */
  .bench-card h3 { font-size: 1.4rem; }
  .bench-card--bet h3 { font-size: 1.6rem; }

  /* The loop: six numbered steps on a brass rule. */
  .loop {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8) var(--space-8);
    margin-bottom: var(--space-12);
  }
  @media (max-width: 56rem) { .loop { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 34rem) { .loop { grid-template-columns: 1fr; } }
  .loop__step { border-top: 1px solid var(--color-border-accent); padding-top: var(--space-4); }
  .loop__n {
    font-family: var(--font__mono);
    font-size: 0.74rem;
    color: var(--color-accent);
    letter-spacing: 0.08em;
  }
  .loop__step h3 { font-size: 1.45rem; margin: var(--space-1) 0 var(--space-2); }
  .loop__step p { color: var(--color-text-dim); font-size: 0.94rem; }

  .diagram-embed {
    margin: 0;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .diagram-embed iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 28rem;
    border: 0;
  }
  .diagram-embed figcaption {
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-dim);
    font-size: 0.9rem;
  }
  .diagram-embed figcaption strong { color: var(--color-text); }

  /* Seven rules: a dense numbered ledger under the two bets. */
  .rules {
    list-style: none;
    margin-top: var(--space-10);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 0 var(--space-10);
  }
  .rules__item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .rules__n { font-family: var(--font__mono); font-size: 0.8rem; color: var(--color-accent); padding-top: 0.35rem; }
  .rules__item h3 { font-size: 1.25rem; margin-bottom: var(--space-1); }
  .rules__item p { color: var(--color-text-dim); font-size: 0.94rem; }

  .reading {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-3);
  }
  .reading a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    color: var(--color-text);
    font-family: var(--font__display);
    font-size: 1.2rem;
  }
  .reading a:hover { border-color: var(--color-border-accent); color: var(--color-text); }
  .reading__kind {
    font-family: var(--font__mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
</style>
